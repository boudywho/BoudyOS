# Don't use quotes( " and ' )

API_ID=
API_HASH=
SESSION=


# [OPTIONAL]

REDIS_URI=
REDIS_PASSWORD=
# 0 is unconfigured. With SKIP_AUTOPILOT=true, set an existing private group ID.
LOG_CHANNEL=0
BOT_TOKEN=

MONGO_URI=
DATABASE_URL=
# LocalDB is permitted unless strict validation is explicitly enabled.
ULTROID_STRICT_CONFIG=false
# Safe first-run defaults; set false to enable the respective BotFather actions.
# Database values take precedence over process environment values.
SKIP_AUTOBOT=true
SKIP_AUTOPILOT=true
SKIP_ASSISTANT_CUSTOMIZE=true
# BoudyOS never autojoins channels or installs dependencies at runtime.
# Install with requirements.txt + constraints/py310.txt or constraints/py313.txt;
# optional database/media profiles: requirements/database.txt, requirements/media.txt.

# New installs default to core,media. Existing installs with no value preserve
# their historical plugin set.
PLUGIN_PROFILES=core,media
PLUGIN_PROFILE_POLICY=new-safe-v1

# Security-sensitive capabilities are opt-in and should normally stay false.
ALLOW_DANGEROUS_DEV_EXEC=false
ALLOW_UNTRUSTED_PLUGINS=false

# Optional exact path to a reviewed root-owned deployment helper.
BOUDYOS_DEPLOY_HELPER=
