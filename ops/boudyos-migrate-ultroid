restore_recorded_state() {
    python3 - "$RECORD" "$OBSOLETE_SOURCE_LINK" "$RUNTIME_LINK" "$DROPIN" \
        "$BACKUP_CONFIG" "$BACKUP_PATHS" "$HEALTH_CONFIG" <<'PY'
import json
import os
import shutil
import stat
import sys
from pathlib import Path

record_name, source_name, runtime_name, dropin_name, backup, paths, health = sys.argv[1:]
record = Path(record_name)
info = record.lstat()
expected_uid = 0 if os.geteuid() == 0 else os.geteuid()
if (
    not stat.S_ISREG(info.st_mode)
    or stat.S_ISLNK(info.st_mode)
    or info.st_uid != expected_uid
    or info.st_mode & 0o077
):
    raise SystemExit("migration state ownership is unsafe")
value = json.loads(record.read_text("utf-8"))
if value.get("schema_version") != 2:
    raise SystemExit("migration state schema is invalid")
snapshot = Path(value["snapshot"]).resolve(strict=True)
config_dir = snapshot / "config"

if value.get("selector_policy") != "remove-managed-selectors-on-legacy-rollback":
    raise SystemExit("migration selector policy is invalid")
for path_name in (source_name, runtime_name):
    try:
        Path(path_name).unlink()
    except FileNotFoundError:
        pass
Path(dropin_name).parent.mkdir(mode=0o755, parents=True, exist_ok=True)
if value["dropin"] == {"state": "file"}:
    shutil.copy2(config_dir / "dropin", dropin_name, follow_symlinks=False)
else:
    try:
        Path(dropin_name).unlink()
    except FileNotFoundError:
        pass
for source, destination in (
    (config_dir / "backup.conf", Path(backup)),
    (config_dir / "backup-paths", Path(paths)),
    (config_dir / "health.conf", Path(health)),
):
    destination.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    temporary = destination.with_name("." + destination.name + ".migration-rollback")
    shutil.copy2(source, temporary, follow_symlinks=False)
    os.replace(temporary, destination)
PY
}

restore_legacy_activation() {
    local reason="$1" replaced_pid
    replaced_pid="$(service_main_pid 2>/dev/null || printf '0')"
    if ! stop_service_verified; then
        echo "$reason; rollback was aborted because the service did not stop." >&2
        return 1
    fi
    restore_recorded_state
    systemctl daemon-reload
    rm -f -- "$READY_FILE"
    if ! systemctl start "$LEGACY_SERVICE" \
        || ! wait_legacy_stable "$replaced_pid"; then
        echo "$reason; original ultroid.service rollback also failed." >&2
        return 1
    fi
    echo "$reason; original ultroid.service was restored." >&2
    return 1
}

resume_legacy_after_prepare() {
    if [[ "${was_active:-0}" == "1" ]]; then
        rm -f -- "$READY_FILE"
        if ! systemctl start "$LEGACY_SERVICE" \
            || ! wait_legacy_stable "${old_pid:-0}"; then
            echo "Migration preparation failed to establish a stable replaced legacy process." >&2
            return 1
        fi
    fi
}

load_prepared_record() {
    python3 - "$RECORD" "$SNAPSHOT_ROOT" "$RUNTIME_ROOT" "$NEW_ENV" \
        "$(id -u "$LEGACY_USER")" "$(getent group "$LEGACY_GROUP" | cut -d: -f3)" <<'PY'
import json, os, stat, sys
from pathlib import Path
record_name, snapshot_root_name, runtime_root_name, env_name, uid, gid = sys.argv[1:]
record = Path(record_name)
snapshot_root = Path(snapshot_root_name).resolve(strict=True)
runtime_root = Path(runtime_root_name).resolve(strict=True)
expected_uid = 0 if os.geteuid() == 0 else os.geteuid()
info = record.lstat()
if (not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode)
        or info.st_uid != expected_uid or info.st_mode & 0o077
        or info.st_size > 16384):
    raise SystemExit("migration record ownership is unsafe")
value = json.loads(record.read_text("utf-8"))
if (value.get("schema_version") != 2
        or value.get("selector_policy") != "remove-managed-selectors-on-legacy-rollback"):
    raise SystemExit("migration record schema is invalid")
snapshot = Path(value["snapshot"]).resolve(strict=True)
seed = Path(value["seed"]).resolve(strict=True)
if snapshot.parent != snapshot_root or seed.parent != runtime_root:
    raise SystemExit("migration record paths escape protected roots")
for path in (snapshot, seed, seed / "work", snapshot / "source", snapshot / "config"):
    path_info = path.lstat()
    if stat.S_ISLNK(path_info.st_mode) or not stat.S_ISDIR(path_info.st_mode):
        raise SystemExit("prepared migration directory is invalid")
work_info = (seed / "work").lstat()
if work_info.st_uid != int(uid) or work_info.st_gid != int(gid) or stat.S_IMODE(work_info.st_mode) != 0o700:
    raise SystemExit("prepared migration work ownership is invalid")
for path in (snapshot / "ultroid.env", snapshot / "config" / "backup.conf",
             snapshot / "config" / "backup-paths", snapshot / "config" / "health.conf",
             Path(env_name)):
    path_info = path.lstat()
    if stat.S_ISLNK(path_info.st_mode) or not stat.S_ISREG(path_info.st_mode):
        raise SystemExit("prepared migration file is invalid")
print(snapshot)
print(seed)
PY
}

prepare() {
    if [[ "$DRY_RUN" == "1" ]]; then
        plan
        return
    fi
    require_root
    [[ -d "$LEGACY_SOURCE" && ! -L "$LEGACY_SOURCE" ]] || {
        echo "Expected regular legacy source directory /opt/ultroid." >&2
        return 1
    }
    [[ -f "$LEGACY_ENV" && ! -L "$LEGACY_ENV" ]] || {
        echo "Expected regular legacy environment file." >&2
        return 1
    }
    getent passwd "$LEGACY_USER" >/dev/null
    if [[ -e "$RECORD" || -L "$RECORD" ]]; then
        local prepared_output snapshot seed
        prepared_output="$(load_prepared_record)" || {
            echo "Existing migration preparation is invalid; use verified rollback before retrying." >&2
            return 1
        }
        snapshot="${prepared_output%%$'\n'*}"
        seed="${prepared_output#*$'\n'}"
        [[ -n "$snapshot" && -n "$seed" && "$snapshot" != "$seed" ]] || {
            echo "Existing migration preparation is incomplete." >&2
            return 1
        }
        validate_legacy_rollback_config "$snapshot" || {
            echo "Existing migration rollback configuration is invalid." >&2
            return 1
        }
        if [[ -e "$DROPIN" || -L "$DROPIN" || -e "$RUNTIME_LINK" || -L "$RUNTIME_LINK" ]]; then
            echo "Migration is already activated or has managed selectors; prepare was not repeated." >&2
            return 1
        fi
        if ! systemctl is-active --quiet "$LEGACY_SERVICE" \
            || [[ "$(service_main_pid 2>/dev/null || printf '0')" == "0" ]]; then
            echo "Prepared migration exists but the legacy service is not active; restore it before continuing." >&2
            return 1
        fi
        printf 'Legacy migration is already prepared and the legacy service is active.\n'
        return 0
    fi
    local was_active=0 old_pid=0 snapshot stamp seed
    if systemctl is-active --quiet "$LEGACY_SERVICE"; then
        old_pid="$(service_main_pid 2>/dev/null || printf '0')"
        if ! stop_service_verified; then
            echo "Could not quiesce ultroid.service; migration was not prepared." >&2
            return 1
        fi
        was_active=1
        trap resume_legacy_after_prepare RETURN
    fi
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    snapshot="$SNAPSHOT_ROOT/$stamp"
    seed="$RUNTIME_ROOT/legacy-$stamp"
    install -d -m 0700 "$SNAPSHOT_ROOT" "$snapshot" "$(dirname "$NEW_ENV")"
    record_migration_state "$snapshot" "$seed"
    validate_legacy_rollback_config "$snapshot"
    install -d -o root -g "$LEGACY_GROUP" -m 0750 "$RUNTIME_ROOT"
    install -d -o root -g "$LEGACY_GROUP" -m 0750 "$seed"
    install -d -o "$LEGACY_USER" -g "$LEGACY_GROUP" -m 0700 "$seed/work"
    local name
    for name in addons downloads sessions db logs temp vcbot; do
        install -d -o "$LEGACY_USER" -g "$LEGACY_GROUP" -m 0700 \
            "$seed/work/$name"
    done
    install -d -o "$LEGACY_USER" -g "$LEGACY_GROUP" -m 0700 \
        "$seed/work/resources"
    for name in auth auths downloads; do
        install -d -o "$LEGACY_USER" -g "$LEGACY_GROUP" -m 0700 \
            "$seed/work/resources/$name"
    done
    cp -a --no-dereference -- "$LEGACY_SOURCE" "$snapshot/source"
    cp -a --no-dereference -- "$LEGACY_ENV" "$snapshot/ultroid.env"
    copy_legacy_mutable_state "$LEGACY_SOURCE" "$seed/work"
    chown -R "$LEGACY_USER:$LEGACY_GROUP" "$seed/work"
    find "$seed/work" -type d -exec chmod u+rwx,go-rwx {} +
    find "$seed/work" -type f -exec chmod u+rw,go-rwx {} +
    install -o root -g "$LEGACY_GROUP" -m 0640 "$LEGACY_ENV" "$NEW_ENV"
    if [[ "$was_active" == "1" ]]; then
        rm -f -- "$READY_FILE"
        systemctl start "$LEGACY_SERVICE"
        wait_legacy_stable "$old_pid"
        was_active=0
    fi
    trap - RETURN
    printf 'Prepared legacy runtime and root-only rollback snapshot.\n'
}

activate() {
    if [[ "$DRY_RUN" == "1" ]]; then
        plan
        return
    fi
    require_root
    [[ -r "$RECORD" && -f "$DEPLOY_CONFIG" && ! -L "$DEPLOY_CONFIG" ]] || {
        echo "Prepare migration and install the root deploy configuration first." >&2
        return 1
    }
    local config_uid config_mode
    config_uid="$(stat -c %u "$DEPLOY_CONFIG")"
    config_mode="$(stat -c %a "$DEPLOY_CONFIG")"
    [[ "$config_uid" == "0" ]] || {
        echo "Migration deploy config must be owned by root." >&2
        return 1
    }
    (( (8#$config_mode & 022) == 0 )) || {
        echo "Migration deploy config must not be group/world writable." >&2
        return 1
    }
    # shellcheck source=/dev/null
    source "$DEPLOY_CONFIG"
    [[ "${BOUDYOS_RELEASE_COMMIT:-}" =~ ^[0-9a-f]{40}$ \
        && "$BOUDYOS_RELEASE_COMMIT" != "0000000000000000000000000000000000000000" ]] || {
        echo "A full release commit is required." >&2
        return 1
    }
    local release_root="${BOUDYOS_RELEASE_ROOT:-/opt/boudyos/releases}"
    local runtime_root="${BOUDYOS_RUNTIME_ROOT:-/var/lib/boudyos/workspaces}"
    local -a staged_paths
    mapfile -t staged_paths < <(
        load_staged_release "$release_root" "$runtime_root" \
            "$BOUDYOS_RELEASE_TAG" "$BOUDYOS_RELEASE_COMMIT"
    ) || {
        echo "Run boudyos-deploy stage; staged release state is invalid." >&2
        return 1
    }
    [[ "${#staged_paths[@]}" == "2" ]] || {
        echo "Run boudyos-deploy stage; staged release state is incomplete." >&2
        return 1
    }
    local release="${staged_paths[0]}"
    local runtime="${staged_paths[1]}"
    local snapshot
    snapshot="$(record_snapshot_path)" || {
        echo "Migration rollback state is invalid." >&2
        return 1
    }
    validate_legacy_rollback_config "$snapshot" || {
        echo "Recorded legacy rollback configuration is invalid." >&2
        return 1
    }
    validate_managed_activation_config "$release_root" "$runtime_root" || {
        echo "Install managed backup/allowlist/health configuration before activation." >&2
        return 1
    }
    if ! verify_staged_release \
        "$release" "$runtime" "$BOUDYOS_RELEASE_TAG" "$BOUDYOS_RELEASE_COMMIT"; then
        echo "Run boudyos-deploy stage; exact staged release verification failed." >&2
        return 1
    fi
    local template="$release/ops/systemd/ultroid-boudyos.conf.example"
    [[ -f "$template" && ! -L "$template" ]] || {
        echo "Migration systemd drop-in template is unavailable." >&2
        return 1
    }
    local old_pid
    old_pid="$(service_main_pid 2>/dev/null || printf '0')"
    if ! stop_service_verified; then
        echo "Migration service stop failed; activation state was not changed." >&2
        return 1
    fi
    copy_legacy_mutable_state "$LEGACY_SOURCE" "$runtime/work"
    chown -R "$LEGACY_USER:$LEGACY_GROUP" "$runtime/work"
    find "$runtime/work" -type d -exec chmod u+rwx,go-rwx {} +
    find "$runtime/work" -type f -exec chmod u+rw,go-rwx {} +
    if ! {
        ln -sfn "$runtime" "$RUNTIME_LINK.new" &&
        mv -Tf "$RUNTIME_LINK.new" "$RUNTIME_LINK" &&
        rm -f -- "$OBSOLETE_SOURCE_LINK" &&
        install -d -m 0755 "$DROPIN_DIR" &&
        install -o root -g root -m 0644 "$template" "$DROPIN" &&
        systemctl daemon-reload
    }; then
        restore_legacy_activation "Migration activation switch failed"
        return 1
    fi
    if ! verify_staged_release \
        "$release" "$runtime" "$BOUDYOS_RELEASE_TAG" "$BOUDYOS_RELEASE_COMMIT"; then
        restore_legacy_activation "Migration target changed before service start"
        return 1
    fi
    rm -f -- "$READY_FILE"
    local started
    started="$(date +%s)"
    if ! systemctl start "$LEGACY_SERVICE"; then
        restore_legacy_activation "Migration service start failed"
        return 1
    fi
    if ! wait_ready "$started" "$old_pid"; then
        restore_legacy_activation "Migration readiness failed"
        return 1
    fi
    local status_dir="${BOUDYOS_STATUS_DIR:-/var/lib/boudyos/status}"
    local app_status_dir="${BOUDYOS_APP_STATUS_DIR:-/var/lib/boudyos/app-status}"
    install -d -o root -g "$LEGACY_GROUP" -m 0750 "$(dirname "$status_dir")"
    install -d -o root -g "$LEGACY_GROUP" -m 0750 "$status_dir"
    install -d -o "$LEGACY_USER" -g "$LEGACY_GROUP" -m 0700 "$app_status_dir"
    local metadata_tmp
    metadata_tmp="$(mktemp "$status_dir/.release.XXXXXX")"
    printf '{"schema_version":1,"tag":"%s","commit":"%s","checked_at":"%s"}\n' \
        "$BOUDYOS_RELEASE_TAG" "$BOUDYOS_RELEASE_COMMIT" \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$metadata_tmp"
    chown "root:$LEGACY_GROUP" "$metadata_tmp"
    chmod 0640 "$metadata_tmp"
    mv -f -- "$metadata_tmp" "$status_dir/release.json"
    printf 'Activated BoudyOS through ultroid.service; verify fresh readiness now.\n'
}

rollback_locked() {
    if [[ "$DRY_RUN" == "1" ]]; then
        plan
        return
    fi
    require_root
    [[ -r "$RECORD" ]] || {
        echo "No migration rollback snapshot is recorded." >&2
        return 1
    }
    local snapshot old_pid
    snapshot="$(record_snapshot_path)" || {
        echo "Migration rollback state is invalid." >&2
        return 1
    }
    validate_legacy_rollback_config "$snapshot" || {
        echo "Recorded legacy backup/health configuration is invalid." >&2
        return 1
    }
    old_pid="$(service_main_pid 2>/dev/null || printf '0')"
    if ! stop_service_verified; then
        echo "Migration rollback stop failed; selectors and configuration were not changed." >&2
        return 1
    fi
    restore_recorded_state
    systemctl daemon-reload
    rm -f -- "$READY_FILE"
    local started
    started="$(date +%s)"
    if ! systemctl start "$LEGACY_SERVICE" \
        || ! wait_ready "$started" "$old_pid"; then
        echo "Legacy state was restored, but a replaced verified process was not established." >&2
        return 1
    fi
    install -d -o root -g "$LEGACY_GROUP" -m 0750 "$STATUS_DIR"
    local backup_tmp
    backup_tmp="$(mktemp "$STATUS_DIR/.backup.XXXXXX")"
    printf '{"schema_version":1,"state":"required","mode":"legacy","checked_at":"%s"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$backup_tmp"
    chown "root:$LEGACY_GROUP" "$backup_tmp"
    chmod 0640 "$backup_tmp"
    mv -f -- "$backup_tmp" "$BACKUP_STATUS"
    rm -f -- "$STATUS_DIR/release.json"
    printf 'Restored legacy service, selectors, and backup/health configuration; snapshot retained.\n'
}

prepare_transition() {
    acquire_transition_lock
    prepare
}

activate_transition() {
    acquire_transition_lock
    activate
}

rollback() {
    if [[ "$DRY_RUN" == "1" ]]; then
        plan
        return
    fi
    require_root
    acquire_transition_lock
    rollback_locked
}

if [[ "${BOUDYOS_MIGRATION_LIB:-0}" != "1" ]]; then
    case "${1:-}" in
        plan) plan ;;
        prepare) prepare_transition ;;
        activate) activate_transition ;;
        rollback) rollback ;;
        *)
            echo "Usage: $0 {plan|prepare|activate|rollback}" >&2
            exit 2
            ;;
    esac
fi
