[Unit]
Description=Check approved BoudyOS release availability
After=network-online.target boudyos-paths.service
Wants=network-online.target
Requires=boudyos-paths.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/boudyos-deploy check
TimeoutStartSec=45s
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/boudyos/status
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
