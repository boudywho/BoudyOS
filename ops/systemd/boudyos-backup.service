[Unit]
Description=Encrypted BoudyOS backup
After=redis-server.service boudyos-paths.service
Requires=boudyos-paths.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/boudyos-backup
TimeoutStartSec=15min
UMask=0077
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/backups/boudyos /var/lib/boudyos/status /run/lock/boudyos
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
