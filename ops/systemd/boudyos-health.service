[Unit]
Description=BoudyOS health and alert probe
After=boudyos.service redis-server.service boudyos-paths.service
Requires=boudyos-paths.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/boudyos-health
TimeoutStartSec=45s
UMask=0077
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/boudyos/status
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
