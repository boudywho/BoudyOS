# Install root:root 0600 as /etc/boudyos/health.conf.
SERVICE=boudyos.service
READY_FILE=/run/boudyos/ready
READY_MAX_AGE_SECONDS=45
BOUDYOS_STATUS_DIR=/var/lib/boudyos/status
BOUDYOS_STATUS_GROUP=boudyos
RUNTIME_USER=boudyos
RUNTIME_GROUP=boudyos
LAYOUT_MODE=managed
RELEASE_ROOT=/opt/boudyos/releases
WORKSPACE_ROOT=/var/lib/boudyos/workspaces
RUNTIME_LINK=/var/lib/boudyos/current
REDIS_ENV_FILE=/etc/boudyos/redis.env
DISK_PATH=/opt/boudyos
BACKUP_MAX_AGE_SECONDS=129600
UPDATE_MAX_AGE_SECONDS=172800
ALERT_COOLDOWN_SECONDS=3600
# Optional; leave blank to disable Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
