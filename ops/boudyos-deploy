#!/usr/bin/env bash
set -euo pipefail
umask 027

readonly APPROVED_ORIGIN="https://github.com/boudywho/BoudyOS.git"
readonly CONFIG_FILE="${BOUDYOS_DEPLOY_CONFIG:-/etc/boudyos/deploy.conf}"

if [[ "${BOUDYOS_DEPLOY_LIB:-0}" != "1" && "${BOUDYOS_DRY_RUN:-0}" != "1" ]]; then
    [[ -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" && -r "$CONFIG_FILE" ]] || {
        echo "A regular root-owned deployment config is required." >&2
        exit 2
    }
    config_uid="$(stat -c %u "$CONFIG_FILE")"
    config_mode="$(stat -c %a "$CONFIG_FILE")"
    [[ "$config_uid" == "0" ]] || {
        echo "Deployment config must be owned by root." >&2
        exit 2
    }
    (( (8#$config_mode & 022) == 0 )) || {
        echo "Deployment config must not be group/world writable." >&2
        exit 2
    }
    # Root-managed file; sudoers never grants SETENV or arbitrary config paths.
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

readonly RELEASE_ROOT="${BOUDYOS_RELEASE_ROOT:-/opt/boudyos/releases}"
readonly RUNTIME_ROOT="${BOUDYOS_RUNTIME_ROOT:-/var/lib/boudyos/workspaces}"
readonly RUNTIME_LINK="${BOUDYOS_RUNTIME_LINK:-/var/lib/boudyos/current}"
readonly RUNTIME_USER="${BOUDYOS_RUNTIME_USER:-boudyos}"
readonly RUNTIME_GROUP="${BOUDYOS_RUNTIME_GROUP:-boudyos}"
readonly RELEASE_OWNER="root"
readonly PREVIOUS_FILE="${BOUDYOS_PREVIOUS_FILE:-/var/lib/boudyos/previous-release}"
readonly STATUS_DIR="${BOUDYOS_STATUS_DIR:-/var/lib/boudyos/status}"
readonly STATE_ROOT="${BOUDYOS_STATE_ROOT:-$(dirname "$STATUS_DIR")}"
readonly APP_STATUS_DIR="${BOUDYOS_APP_STATUS_DIR:-/var/lib/boudyos/app-status}"
readonly STATUS_GROUP="${BOUDYOS_STATUS_GROUP:-$RUNTIME_GROUP}"
readonly STATUS_FILE="${BOUDYOS_DEPLOY_STATUS:-$STATUS_DIR/deploy.json}"
readonly UPDATE_STATUS_FILE="${BOUDYOS_UPDATE_STATUS:-$STATUS_DIR/update.json}"
readonly RELEASE_METADATA="${BOUDYOS_RELEASE_METADATA:-$STATUS_DIR/release.json}"
readonly STAGED_METADATA="${BOUDYOS_STAGED_METADATA:-$STATUS_DIR/staged-release.json}"
readonly REQUEST_FILE="${BOUDYOS_DEPLOY_REQUEST:-/var/lib/boudyos/deploy.request}"
if [[ "${BOUDYOS_DEPLOY_LIB:-0}" == "1" ]]; then
    readonly LOCK_FILE="${BOUDYOS_DEPLOY_LOCK:-/tmp/boudyos-deploy-test.lock}"
else
    readonly LOCK_FILE="/run/lock/boudyos/deploy.lock"
fi
readonly SERVICE="${BOUDYOS_SERVICE:-boudyos.service}"
readonly READY_FILE="${BOUDYOS_READY_FILE:-/run/boudyos/ready}"
readonly READY_MAX_AGE="${BOUDYOS_READY_MAX_AGE_SECONDS:-45}"
readonly KEEP_RELEASES="${BOUDYOS_KEEP_RELEASES:-5}"
readonly DRY_RUN="${BOUDYOS_DRY_RUN:-0}"
readonly PERSIST_NAMES="${BOUDYOS_PERSIST_NAMES:-.env database.json ultroid.json .megarc addons downloads sessions db logs temp vcbot resources/auth resources/auths resources/downloads}"
readonly MUTABLE_TOP_LEVEL="addons downloads sessions db logs temp vcbot"
readonly MUTABLE_RESOURCES="auth auths downloads"

STATUS_OWNER="root"
STATUS_OWNER_UID="0"
if [[ "${BOUDYOS_DEPLOY_LIB:-0}" == "1" && "$(id -u)" != "0" ]]; then
    # Unit-test library mode cannot manufacture root ownership.
    STATUS_OWNER="$(id -un)"
    STATUS_OWNER_UID="$(id -u)"
fi
readonly STATUS_OWNER STATUS_OWNER_UID

RELEASE_TAG=""
RELEASE_COMMIT=""

ensure_status_dir() {
    install -d -o "$STATUS_OWNER" -g "$RUNTIME_GROUP" -m 0750 "$STATE_ROOT"
    install -d -o "$STATUS_OWNER" -g "$STATUS_GROUP" -m 0750 "$STATUS_DIR"
}

ensure_app_status_dir() {
    install -d -o "$STATUS_OWNER" -g "$RUNTIME_GROUP" -m 0750 "$STATE_ROOT"
    install -d -o "$RUNTIME_USER" -g "$RUNTIME_GROUP" -m 0700 "$APP_STATUS_DIR"
}

json_status() {
    local state="$1" message="$2"
    if [[ "$DRY_RUN" == "1" ]]; then
        printf '{"schema_version":1,"state":"%s","message":"%s","dry_run":true}\n' \
            "$state" "$message"
        return
    fi
    ensure_status_dir
    local temporary
    temporary="$(mktemp "$STATUS_DIR/.deploy.XXXXXX")"
    printf '{"schema_version":1,"state":"%s","message":"%s","checked_at":"%s","tag":"%s","commit":"%s"}\n' \
        "$state" "$message" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$RELEASE_TAG" "$RELEASE_COMMIT" >"$temporary"
    chmod 0640 "$temporary"
    chown "$STATUS_OWNER:$STATUS_GROUP" "$temporary"
    mv -f -- "$temporary" "$STATUS_FILE"
}

update_status() {
    local state="$1"
    ensure_status_dir
    local temporary
    temporary="$(mktemp "$STATUS_DIR/.update.XXXXXX")"
    printf '{"schema_version":1,"state":"%s","checked_at":"%s","tag":"%s","commit":"%s"}\n' \
        "$state" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$RELEASE_TAG" "$RELEASE_COMMIT" >"$temporary"
    chmod 0640 "$temporary"
    chown "$STATUS_OWNER:$STATUS_GROUP" "$temporary"
    mv -f -- "$temporary" "$UPDATE_STATUS_FILE"
}

load_release_config() {
    RELEASE_TAG="${BOUDYOS_RELEASE_TAG:-}"
    RELEASE_COMMIT="${BOUDYOS_RELEASE_COMMIT:-}"
    [[ "$RELEASE_TAG" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
        echo "BOUDYOS_RELEASE_TAG must pin a release tag." >&2
        return 2
    }
    [[ "$RELEASE_COMMIT" =~ ^[0-9a-f]{40}$ \
        && "$RELEASE_COMMIT" != "0000000000000000000000000000000000000000" ]] || {
        echo "BOUDYOS_RELEASE_COMMIT must be a full 40-character commit." >&2
        return 2
    }
}

active_commit() {
    local runtime
    runtime="$(readlink -f "$RUNTIME_LINK" 2>/dev/null || true)"
    if [[ -n "$runtime" && -L "$runtime/source" ]]; then
        git -C "$runtime/source" rev-parse HEAD 2>/dev/null || true
    fi
}

active_tag() {
    if [[ -r "$RELEASE_METADATA" ]]; then
        python3 - "$RELEASE_METADATA" <<'PY' 2>/dev/null || true
import json, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
print(value.get("tag", ""))
PY
    fi
}

active_release_verified() {
    [[ -L "$RUNTIME_LINK" ]] || return 1
    local source runtime
    runtime="$(readlink -f "$RUNTIME_LINK" 2>/dev/null)" || return 1
    source="$(readlink -f "$runtime/source" 2>/dev/null)" || return 1
    [[ -d "$source" && -d "$runtime" ]] || return 1
    validated_managed_runtime "$runtime" "$RELEASE_COMMIT" || return 1
    local -a identity=()
    mapfile -t identity < <(validated_managed_release_identity "$source") \
        || return 1
    [[ "${identity[0]:-}" == "$RELEASE_TAG" \
        && "${identity[1]:-}" == "$RELEASE_COMMIT" ]] || return 1
    [[ -f "$RELEASE_METADATA" && ! -L "$RELEASE_METADATA" \
        && "$(stat -c %u "$RELEASE_METADATA")" == "$STATUS_OWNER_UID" ]] \
        || return 1
    local metadata_mode
    metadata_mode="$(stat -c %a "$RELEASE_METADATA")" || return 1
    (( (8#$metadata_mode & 022) == 0 )) || return 1
    python3 - "$RELEASE_METADATA" "$RELEASE_TAG" "$RELEASE_COMMIT" <<'PY'
import json, sys
path, tag, commit = sys.argv[1:]
try:
    with open(path, encoding="utf-8") as stream:
        value = json.load(stream)
except (OSError, ValueError):
    raise SystemExit(1)
ok = (
    value.get("schema_version") == 1
    and value.get("tag") == tag
    and value.get("commit") == commit
    and isinstance(value.get("checked_at"), str)
)
raise SystemExit(0 if ok else 1)
PY
}

runtime_layout_verified() {
    local source="${1:?source required}" runtime="${2:?runtime required}"
    local release_uid runtime_uid runtime_gid
    release_uid="$(id -u "$RELEASE_OWNER")" || return 1
    runtime_uid="$(id -u "$RUNTIME_USER")" || return 1
    runtime_gid="$(getent group "$RUNTIME_GROUP" | cut -d: -f3)" || return 1
    [[ -n "$runtime_gid" ]] || return 1
    if [[ "${BOUDYOS_DEPLOY_LIB:-0}" != "1" ]]; then
        [[ "$release_uid" != "$runtime_uid" ]] || return 1
    fi
    python3 - "$source" "$runtime" "$release_uid" "$runtime_uid" \
        "$runtime_gid" <<'PY'
import os
import stat
import sys
from pathlib import Path

source = Path(sys.argv[1]).resolve(strict=True)
runtime = Path(sys.argv[2]).resolve(strict=True)
release_uid = int(sys.argv[3])
runtime_uid = int(sys.argv[4])
runtime_gid = int(sys.argv[5])
mutable_top = {"addons", "downloads", "sessions", "db", "logs", "temp", "vcbot"}
mutable_resources = {"auth", "auths", "downloads"}
official_selectors = {
    "pyUltroid", "plugins", "assistant", "strings", "startup", "resources",
}

def checked_directory(path, uid, gid=None, exact_mode=None):
    info = path.lstat()
    if (
        stat.S_ISLNK(info.st_mode)
        or not stat.S_ISDIR(info.st_mode)
        or info.st_uid != uid
        or (gid is not None and info.st_gid != gid)
        or (exact_mode is not None and stat.S_IMODE(info.st_mode) != exact_mode)
    ):
        raise SystemExit(1)

checked_directory(source, release_uid)
if source.lstat().st_gid != runtime_gid \
        or stat.S_IMODE(source.lstat().st_mode) != 0o750:
    raise SystemExit(1)
for directory, names, files in os.walk(source, followlinks=False):
    base = Path(directory)
    for name in names + files:
        child = base / name
        info = child.lstat()
        if info.st_uid != release_uid:
            raise SystemExit(1)
        if stat.S_ISLNK(info.st_mode):
            try:
                target = child.resolve(strict=True)
            except OSError:
                raise SystemExit(1)
            if target.is_relative_to(source):
                continue
            # Venv interpreter links may select a system binary. Every external
            # target and parent selector must be root-owned and non-writable.
            for selector in (target, *target.parents[:-1]):
                selector_info = selector.lstat()
                if (
                    selector_info.st_uid != 0
                    or selector_info.st_mode & 0o022
                ):
                    raise SystemExit(1)
            continue
        if not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            raise SystemExit(1)
        if info.st_mode & 0o027:
            raise SystemExit(1)

checked_directory(runtime, release_uid, runtime_gid, 0o750)
if {child.name for child in runtime.iterdir()} != {"source", "work"}:
    raise SystemExit(1)
source_link = runtime / "source"
source_link_info = source_link.lstat()
if (
    not stat.S_ISLNK(source_link_info.st_mode)
    or source_link_info.st_uid != release_uid
    or source_link_info.st_gid != runtime_gid
    or os.readlink(source_link) != str(source)
    or source_link.resolve(strict=True) != source
):
    raise SystemExit(1)
work = runtime / "work"
checked_directory(work, runtime_uid, runtime_gid, 0o700)
if any((work / name).exists() or (work / name).is_symlink()
       for name in official_selectors - {"resources"}):
    raise SystemExit(1)
for directory, names, files in os.walk(work, followlinks=False):
    base = Path(directory)
    for name in names + files:
        info = (base / name).lstat()
        if (
            stat.S_ISLNK(info.st_mode)
            or info.st_uid != runtime_uid
            or info.st_gid != runtime_gid
            or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode))
        ):
            raise SystemExit(1)
        mode = stat.S_IMODE(info.st_mode)
        if (
            stat.S_ISDIR(info.st_mode) and mode != 0o700
            or stat.S_ISREG(info.st_mode) and mode not in (0o600, 0o700)
        ):
            raise SystemExit(1)
for name in mutable_top:
    checked_directory(work / name, runtime_uid, runtime_gid, 0o700)
resources = work / "resources"
checked_directory(resources, runtime_uid, runtime_gid, 0o700)
if {child.name for child in resources.iterdir()} != mutable_resources:
    raise SystemExit(1)
for name in mutable_resources:
    checked_directory(resources / name, runtime_uid, runtime_gid, 0o700)
PY
}

fetch_exact_release() {
    local destination="$1"
    git -C "$destination" init --quiet
    git -C "$destination" remote add origin "$APPROVED_ORIGIN"
    timeout 180 git -C "$destination" fetch --quiet --force --no-tags origin \
        "+refs/tags/$RELEASE_TAG:refs/tags/$RELEASE_TAG"
    local peeled
    peeled="$(git -C "$destination" rev-parse "refs/tags/$RELEASE_TAG^{commit}")"
    [[ "$peeled" == "$RELEASE_COMMIT" ]] || {
        echo "Pinned commit does not match the peeled release tag." >&2
        return 1
    }
    git -C "$destination" checkout --quiet --detach "$RELEASE_COMMIT"
    [[ "$(git -C "$destination" rev-parse HEAD)" == "$RELEASE_COMMIT" ]]
    [[ "$(git -C "$destination" remote get-url origin)" == "$APPROVED_ORIGIN" ]]
    [[ -z "$(git -C "$destination" status --porcelain --untracked-files=normal)" ]]
}

verify_forward_history() {
    local repository="$1" current="$2"
    [[ -z "$current" || "$current" == "$RELEASE_COMMIT" ]] && return 0
    git -C "$repository" cat-file -e "$current^{commit}" 2>/dev/null || {
        echo "Active commit is not in the target tag history." >&2
        return 1
    }
    git -C "$repository" merge-base --is-ancestor "$current" "$RELEASE_COMMIT" || {
        echo "Refusing a downgrade or unrelated release." >&2
        return 1
    }
}

preflight_release() {
    if [[ "$DRY_RUN" == "1" ]]; then
        json_status "preflight" "dry-run preflight passed"
        return
    fi
    local source="${1:?source required}"
    load_release_config
    [[ "$(git -C "$source" remote get-url origin)" == "$APPROVED_ORIGIN" ]]
    [[ "$(git -C "$source" rev-parse HEAD)" == "$RELEASE_COMMIT" ]]
    [[ "$(git -C "$source" rev-parse "refs/tags/$RELEASE_TAG^{commit}")" == "$RELEASE_COMMIT" ]]
    [[ -z "$(GIT_OPTIONAL_LOCKS=0 git -C "$source" status \
        --porcelain --untracked-files=normal)" ]]
    "$source/.venv/bin/python" -c \
        'import bs4, hiredis, htmlwebshot, psycopg2, pymongo, redis, telethonpatch; from telethonpatch import TelegramClient'
    "$source/.venv/bin/python" -m unittest discover -s "$source/tests" -v
    "$source/.venv/bin/python" -m compileall -q "$source/pyUltroid" \
        "$source/plugins" "$source/assistant"
    "$source/.venv/bin/python" -m pip check
    while IFS= read -r -d '' json_file; do
        "$source/.venv/bin/python" -m json.tool "$json_file" >/dev/null
    done < <(find "$source" -type f -name '*.json' -not -path '*/.git/*' -print0)
    while IFS= read -r -d '' yaml_file; do
        "$source/.venv/bin/python" - "$yaml_file" <<'PY'
import sys, yaml
with open(sys.argv[1], encoding="utf-8") as stream:
    yaml.safe_load(stream)
PY
    done < <(find "$source" -type f \( -name '*.yml' -o -name '*.yaml' \) -not -path '*/.git/*' -print0)
    while IFS= read -r -d '' script; do
        bash -n "$script"
    done < <(find "$source/ops" -type f -perm -0100 -print0)
    git -C "$source" diff --check
}

validate_state_source() {
    python3 - "${1:?state source required}" <<'PY'
import os
import stat
import sys
from pathlib import Path

source = Path(sys.argv[1])
info = source.lstat()
if stat.S_ISLNK(info.st_mode) or not (
    stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode)
):
    raise SystemExit("mutable state source is a link or special entry")
if stat.S_ISDIR(info.st_mode):
    for directory, names, files in os.walk(source, followlinks=False):
        base = Path(directory)
        for name in names + files:
            mode = (base / name).lstat().st_mode
            if stat.S_ISLNK(mode) or not (
                stat.S_ISREG(mode) or stat.S_ISDIR(mode)
            ):
                raise SystemExit("mutable state tree contains a link or special entry")
PY
}

copy_preserved_state() {
    local prior="$1" destination="$2" name source target
    [[ ! -L "$prior" ]] || {
        echo "Prior mutable runtime source must not be a symlink." >&2
        return 1
    }
    [[ -d "$prior" ]] || return 0
    for name in $PERSIST_NAMES; do
        source="$prior/$name"
        target="$destination/$name"
        [[ -e "$source" || -L "$source" ]] || continue
        validate_state_source "$source"
        rm -rf --one-file-system -- "$target"
        install -d -m 0700 "$(dirname "$target")"
        cp -a --no-dereference -- "$source" "$target"
    done
    while IFS= read -r -d '' source; do
        target="$destination/$(basename "$source")"
        [[ -e "$target" ]] && continue
        validate_state_source "$source"
        cp -a --no-dereference -- "$source" "$target"
    done < <(
        find "$prior" -maxdepth 1 \
            \( -name '*.session' -o -name '*.session-*' -o -name '*.db' \
            -o -name '*.sqlite' -o -name '*.sqlite3' \) -print0
    )
}

prepare_runtime() {
    local source="$1" destination="$2" prior_runtime="${3:-}"
    # The fourth argument is retained for compatibility with staged callers,
    # but executable source is never linked or copied into the workspace.
    local _immutable_source="${4:-$source}" prior_state name
    : "$_immutable_source"
    install -d -o "$RELEASE_OWNER" -g "$RUNTIME_GROUP" -m 0750 "$destination"
    ln -s -- "$_immutable_source" "$destination/source"
    chown -h "$RELEASE_OWNER:$RUNTIME_GROUP" "$destination/source"
    install -d -o "$RUNTIME_USER" -g "$RUNTIME_GROUP" -m 0700 \
        "$destination/work"
    for name in $MUTABLE_TOP_LEVEL; do
        install -d -o "$RUNTIME_USER" -g "$RUNTIME_GROUP" -m 0700 \
            "$destination/work/$name"
    done
    install -d -o "$RUNTIME_USER" -g "$RUNTIME_GROUP" -m 0700 \
        "$destination/work/resources"
    for name in $MUTABLE_RESOURCES; do
        install -d -o "$RUNTIME_USER" -g "$RUNTIME_GROUP" -m 0700 \
            "$destination/work/resources/$name"
    done
    prior_state="$prior_runtime"
    if [[ -d "$prior_runtime/work" && ! -L "$prior_runtime/work" ]]; then
        prior_state="$prior_runtime/work"
    fi
    copy_preserved_state "$prior_state" "$destination/work"
    # Only the state subtree is service-owned. It is link-free by validation
    # and contains no official source selector.
    chown -R "$RUNTIME_USER:$RUNTIME_GROUP" "$destination/work"
    find "$destination/work" -type d -exec chmod u+rwx,go-rwx {} +
    find "$destination/work" -type f -exec chmod u+rw,go-rwx {} +
    ensure_app_status_dir
}

secure_release() {
    local release="${1:?release required}"
    chown -R "$RELEASE_OWNER:$RUNTIME_GROUP" "$release"
    chmod -R u=rwX,g=rX,o= "$release"
}

ready_is_fresh() {
    local not_before="$1" old_pid="${2:-0}" main_pid
    main_pid="$(systemctl show "$SERVICE" --property=MainPID --value 2>/dev/null)" || return 1
    [[ "$main_pid" =~ ^[1-9][0-9]*$ ]] || return 1
    [[ "$main_pid" != "$old_pid" ]] || return 1
    python3 - "$READY_FILE" "$main_pid" "$not_before" "$READY_MAX_AGE" <<'PY'
import json, os, sys, time
path, expected_pid, not_before, max_age = sys.argv[1:]
try:
    value = json.load(open(path, encoding="ascii"))
    stamp = int(value["timestamp"])
    pid = int(value["pid"])
except (OSError, ValueError, KeyError, TypeError):
    raise SystemExit(1)
now = int(time.time())
ok = (
    value.get("schema_version") == 1
    and pid == int(expected_pid)
    and stamp >= int(not_before)
    and 0 <= now - stamp <= int(max_age)
)
raise SystemExit(0 if ok else 1)
PY
}

wait_ready() {
    local not_before="$1" old_pid="${2:-0}" _
    for _ in {1..60}; do
        if systemctl is-active --quiet "$SERVICE" \
            && ready_is_fresh "$not_before" "$old_pid"; then
            return 0
        fi
        sleep 1
    done
    return 1
}

service_main_pid() {
    local pid
    pid="$(systemctl show "$SERVICE" --property=MainPID --value 2>/dev/null)" \
        || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$pid"
}

stop_service_verified() {
    local active_state
    systemctl stop "$SERVICE" || return 1
    active_state="$(systemctl is-active "$SERVICE" 2>/dev/null || true)"
    [[ "$active_state" == "inactive" ]] || return 1
    [[ "$(service_main_pid)" == "0" ]]
}

acquire_transition_lock() {
    install -d -m 0750 "$(dirname "$LOCK_FILE")"
    exec 9>"$LOCK_FILE"
    flock -n 9 || {
        echo "Another deployment or rollback transition is active." >&2
        return 1
    }
}

write_release_metadata() {
    local tag="${1:-$RELEASE_TAG}" commit="${2:-$RELEASE_COMMIT}"
    [[ "$tag" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ \
        && "$commit" =~ ^[0-9a-f]{40}$ \
        && "$commit" != "0000000000000000000000000000000000000000" ]] || {
        echo "Refusing to publish invalid release metadata." >&2
        return 1
    }
    ensure_status_dir
    local temporary
    temporary="$(mktemp "$STATUS_DIR/.release.XXXXXX")"
    printf '{"schema_version":1,"tag":"%s","commit":"%s","checked_at":"%s"}\n' \
        "$tag" "$commit" \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$temporary"
    chmod 0640 "$temporary"
    chown "$STATUS_OWNER:$STATUS_GROUP" "$temporary"
    mv -f -- "$temporary" "$RELEASE_METADATA"
}

validated_managed_release_identity() {
    local source="${1:?source required}"
    local root_real source_real commit tag release_uid runtime_gid
    [[ -d "$RELEASE_ROOT" && ! -L "$RELEASE_ROOT" \
        && -d "$source" && ! -L "$source" ]] || return 1
    release_uid="$(id -u "$RELEASE_OWNER")" || return 1
    runtime_gid="$(getent group "$RUNTIME_GROUP" | cut -d: -f3)" || return 1
    [[ -n "$runtime_gid" \
        && "$(stat -c %u "$RELEASE_ROOT")" == "$release_uid" \
        && "$(stat -c %g "$RELEASE_ROOT")" == "$runtime_gid" \
        && "$(stat -c %a "$RELEASE_ROOT")" == "750" ]] || return 1
    root_real="$(readlink -f "$RELEASE_ROOT")" || return 1
    source_real="$(readlink -f "$source")" || return 1
    [[ "$(dirname "$source_real")" == "$root_real" ]] || return 1
    commit="$(basename "$source_real")"
    [[ "$commit" =~ ^[0-9a-f]{40}$ \
        && "$commit" != "0000000000000000000000000000000000000000" ]] \
        || return 1
    [[ "$(git -C "$source_real" remote get-url origin 2>/dev/null)" == \
        "$APPROVED_ORIGIN" ]] || return 1
    [[ "$(git -C "$source_real" rev-parse HEAD 2>/dev/null)" == "$commit" ]] \
        || return 1
    [[ -z "$(GIT_OPTIONAL_LOCKS=0 git -C "$source_real" status \
        --porcelain --untracked-files=normal)" ]] \
        || return 1
    local -a release_tags=()
    while IFS= read -r tag; do
        [[ "$tag" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
        [[ "$(git -C "$source_real" rev-parse "refs/tags/$tag^{commit}" \
            2>/dev/null)" == "$commit" ]] || continue
        release_tags+=("$tag")
    done < <(git -C "$source_real" tag --points-at "$commit")
    [[ "${#release_tags[@]}" == "1" ]] || return 1
    printf '%s\n%s\n' "${release_tags[0]}" "$commit"
}

validated_managed_runtime() {
    local runtime="${1:?runtime required}" commit="${2:?commit required}"
    local root_real runtime_real source release_uid runtime_gid root_mode
    [[ "$commit" =~ ^[0-9a-f]{40}$ \
        && "$commit" != "0000000000000000000000000000000000000000" ]] \
        || return 1
    [[ -d "$RUNTIME_ROOT" && ! -L "$RUNTIME_ROOT" \
        && -d "$runtime" && ! -L "$runtime" ]] || return 1
    release_uid="$(id -u "$RELEASE_OWNER")" || return 1
    runtime_gid="$(getent group "$RUNTIME_GROUP" | cut -d: -f3)" || return 1
    [[ -n "$runtime_gid" ]] || return 1
    [[ "$(stat -c %u "$RUNTIME_ROOT")" == "$release_uid" \
        && "$(stat -c %g "$RUNTIME_ROOT")" == "$runtime_gid" ]] || return 1
    root_mode="$(stat -c %a "$RUNTIME_ROOT")" || return 1
    [[ "$root_mode" == "750" ]] || return 1
    root_real="$(readlink -f "$RUNTIME_ROOT")" || return 1
    runtime_real="$(readlink -f "$runtime")" || return 1
    [[ "$runtime_real" == "$root_real/$commit" ]] || return 1
    source="$RELEASE_ROOT/$commit"
    [[ -L "$runtime_real/source" \
        && "$(stat -c %u "$runtime_real/source")" == "$release_uid" \
        && "$(stat -c %g "$runtime_real/source")" == "$runtime_gid" \
        && "$(readlink "$runtime_real/source")" == "$source" \
        && -d "$source" && ! -L "$source" ]] || return 1
    local -a identity=()
    mapfile -t identity < <(validated_managed_release_identity "$source") \
        || return 1
    [[ "${#identity[@]}" == "2" && "${identity[1]}" == "$commit" ]] || return 1
    runtime_layout_verified "$source" "$runtime_real"
}

validated_activation_pair() {
    local source="${1:?source required}" runtime="${2:?runtime required}"
    local expected_tag="${3:-}" expected_commit="${4:-}"
    local -a identity=()
    mapfile -t identity < <(validated_managed_release_identity "$source") \
        || return 1
    [[ "${#identity[@]}" == "2" ]] || return 1
    [[ -z "$expected_tag" || "${identity[0]}" == "$expected_tag" ]] || return 1
    [[ -z "$expected_commit" || "${identity[1]}" == "$expected_commit" ]] \
        || return 1
    validated_managed_runtime "$runtime" "${identity[1]}"
}

publish_rollback_metadata() {
    local tag="${1:?tag required}" commit="${2:?commit required}" reason="$3"
    local target_tag="$RELEASE_TAG" target_commit="$RELEASE_COMMIT"
    local target_state="available"
    [[ "$commit" != "$target_commit" ]] || target_state="current"
    write_release_metadata "$tag" "$commit"
    update_status "$target_state"
    RELEASE_TAG="$tag"
    RELEASE_COMMIT="$commit"
    json_status "rolled_back" "$reason"
    RELEASE_TAG="$target_tag"
    RELEASE_COMMIT="$target_commit"
}

write_staged_release_metadata() {
    local release="${1:?release required}" runtime="${2:?runtime required}"
    [[ "$release" == "$RELEASE_ROOT/$RELEASE_COMMIT" \
        && "$runtime" == "$RUNTIME_ROOT/$RELEASE_COMMIT" \
        && ! -L "$RELEASE_ROOT" && ! -L "$RUNTIME_ROOT" \
        && ! -L "$release" && ! -L "$runtime" \
        && -d "$release" && -d "$runtime" ]] || {
        echo "Refusing to record an unexpected staged release path." >&2
        return 1
    }
    validated_activation_pair "$release" "$runtime" \
        "$RELEASE_TAG" "$RELEASE_COMMIT" || {
        echo "Refusing to record an invalid staged release workspace." >&2
        return 1
    }
    ensure_status_dir
    local temporary
    temporary="$(mktemp "$STATUS_DIR/.staged-release.XXXXXX")"
    python3 - "$RELEASE_TAG" "$RELEASE_COMMIT" "$release" "$runtime" \
        >"$temporary" <<'PY'
import json
import sys
from datetime import datetime, timezone

tag, commit, release, runtime = sys.argv[1:]
json.dump(
    {
        "schema_version": 1,
        "tag": tag,
        "commit": commit,
        "release_path": release,
        "runtime_path": runtime,
        "checked_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    },
    sys.stdout,
    separators=(",", ":"),
)
sys.stdout.write("\n")
PY
    chmod 0640 "$temporary"
    chown "$STATUS_OWNER:$STATUS_GROUP" "$temporary"
    mv -f -- "$temporary" "$STAGED_METADATA"
}

set_active_workspace() {
    local runtime="$1"
    ln -sfn "$runtime" "$RUNTIME_LINK.new" || return 1
    mv -Tf "$RUNTIME_LINK.new" "$RUNTIME_LINK" || return 1
}

write_previous_release() {
    local source="${1:?source required}" runtime="${2:?runtime required}"
    install -d -m 0750 "$(dirname "$PREVIOUS_FILE")"
    local temporary
    temporary="$(mktemp "$(dirname "$PREVIOUS_FILE")/.previous-release.XXXXXX")"
    printf '%s\n%s\n' "$source" "$runtime" >"$temporary"
    chmod 0600 "$temporary"
    chown "$STATUS_OWNER" "$temporary"
    mv -f -- "$temporary" "$PREVIOUS_FILE"
}

read_previous_release() {
    python3 - "$PREVIOUS_FILE" "$STATUS_OWNER_UID" <<'PY'
import os
import stat
import sys
from pathlib import Path

path = Path(sys.argv[1])
expected_uid = int(sys.argv[2])
try:
    info = path.lstat()
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != expected_uid
        or info.st_mode & 0o077
        or info.st_size > 16 * 1024
    ):
        raise ValueError
    lines = path.read_text("utf-8").splitlines()
except (OSError, UnicodeError, ValueError):
    raise SystemExit(1)
if len(lines) != 2 or not all(line.startswith("/") for line in lines):
    raise SystemExit(1)
print(lines[0])
print(lines[1])
PY
}

rollback_activation() {
    local previous_source="$1" previous_runtime="$2" reason="$3"
    local previous_tag="${4:-}" previous_commit="${5:-}"
    local replaced_pid
    replaced_pid="$(service_main_pid 2>/dev/null || printf '0')"
    if ! stop_service_verified; then
        json_status "rollback_failed" \
            "$reason; failed service could not be confirmed stopped"
        echo "Activation failed; rollback was aborted because the service did not stop." >&2
        return 1
    fi
    if [[ -z "$previous_source" || -z "$previous_runtime" \
        || -z "$previous_tag" || -z "$previous_commit" ]] \
        || ! validated_activation_pair "$previous_source" "$previous_runtime" \
            "$previous_tag" "$previous_commit"; then
        json_status "activation_failed" "$reason; no previous release was available"
        echo "Activation failed and no validated rollback release is available." >&2
        return 1
    fi
    set_active_workspace "$previous_runtime"
    rm -f -- "$READY_FILE"
    if ! validated_activation_pair "$previous_source" "$previous_runtime" \
        "$previous_tag" "$previous_commit"; then
        json_status "rollback_failed" \
            "$reason; previous release changed before service start"
        echo "Activation failed; rollback target failed its second validation." >&2
        return 1
    fi
    local rollback_started
    rollback_started="$(date +%s)"
    if ! systemctl start "$SERVICE"; then
        json_status "rollback_failed" "$reason; previous service failed to start"
        echo "Activation and rollback start both failed." >&2
        return 1
    fi
    if ! wait_ready "$rollback_started" "$replaced_pid"; then
        json_status "rollback_failed" "$reason; previous release was not fresh-ready"
        echo "Activation failed and rollback did not become fresh-ready." >&2
        return 1
    fi
    publish_rollback_metadata "$previous_tag" "$previous_commit" \
        "$reason; previous release is active and fresh-ready"
    echo "Activation failed; rollback is active and fresh-ready." >&2
    return 1
}

activate_release() {
    local release_dir="$1" runtime_dir="$2"
    local previous_source="" previous_runtime=""
    local previous_tag="" previous_commit=""
    if ! validated_activation_pair "$release_dir" "$runtime_dir" \
        "$RELEASE_TAG" "$RELEASE_COMMIT"; then
        json_status "activation_failed" \
            "new release or workspace failed exact activation validation"
        echo "Refusing to activate an invalid release workspace." >&2
        return 1
    fi
    previous_runtime="$(readlink -f "$RUNTIME_LINK" 2>/dev/null || true)"
    previous_source="$(readlink -f "$previous_runtime/source" 2>/dev/null || true)"
    local -a previous_identity=()
    if [[ -n "$previous_source" && -n "$previous_runtime" ]]; then
        mapfile -t previous_identity < <(
            validated_managed_release_identity "$previous_source"
        ) || previous_identity=()
        if [[ "${#previous_identity[@]}" == "2" ]] \
            && validated_managed_runtime \
                "$previous_runtime" "${previous_identity[1]}"; then
            previous_tag="${previous_identity[0]}"
            previous_commit="${previous_identity[1]}"
        fi
    fi
    install -d -m 0750 "$(dirname "$RUNTIME_LINK")" \
        "$(dirname "$PREVIOUS_FILE")"
    local old_pid
    old_pid="$(service_main_pid 2>/dev/null || printf '0')"
    if ! stop_service_verified; then
        json_status "activation_failed" \
            "service stop failed or inactive state was not confirmed"
        echo "Service stop was not verified; activation was not changed." >&2
        return 1
    fi
    if [[ -n "$previous_source" && -n "$previous_runtime" ]]; then
        write_previous_release "$previous_source" "$previous_runtime"
    fi
    if ! set_active_workspace "$runtime_dir"; then
        rollback_activation "$previous_source" "$previous_runtime" \
            "activation link switch failed" "$previous_tag" "$previous_commit"
        return 1
    fi
    rm -f -- "$READY_FILE"
    if ! validated_activation_pair "$release_dir" "$runtime_dir" \
        "$RELEASE_TAG" "$RELEASE_COMMIT"; then
        rollback_activation "$previous_source" "$previous_runtime" \
            "activated target changed before service start" \
            "$previous_tag" "$previous_commit"
        return 1
    fi
    local started
    started="$(date +%s)"
    if ! systemctl start "$SERVICE"; then
        rollback_activation "$previous_source" "$previous_runtime" \
            "service start failed" "$previous_tag" "$previous_commit"
        return 1
    fi
    if ! wait_ready "$started" "$old_pid"; then
        rollback_activation "$previous_source" "$previous_runtime" \
            "readiness failed" "$previous_tag" "$previous_commit"
        return 1
    fi
    write_release_metadata
    json_status "ready" "release activated and fresh readiness confirmed"
}

check_release() {
    if [[ "$DRY_RUN" == "1" ]]; then
        json_status "check" "approved origin and pinned release policy passed"
        return
    fi
    load_release_config
    local stage current
    stage="$(mktemp -d "${TMPDIR:-/tmp}/boudyos-check.XXXXXX")"
    trap 'rm -rf --one-file-system -- "$stage"' RETURN
    fetch_exact_release "$stage"
    current="$(active_commit)"
    verify_forward_history "$stage" "$current"
    if [[ "$current" == "$RELEASE_COMMIT" ]]; then
        if ! active_release_verified; then
            update_status "blocked"
            json_status "blocked" "active release failed exact source or runtime verification"
            return 1
        fi
        update_status "current"
        json_status "current" "configured release is already active"
    else
        update_status "available"
        json_status "available" "verified forward release is available"
    fi
    rm -rf --one-file-system -- "$stage"
    trap - RETURN
}

queue_release_request() {
    install -d -m 0750 "$(dirname "$REQUEST_FILE")"
    local temporary
    temporary="$(mktemp "$(dirname "$REQUEST_FILE")/.deploy-request.XXXXXX")"
    printf '%s %s %s\n' "$RELEASE_TAG" "$RELEASE_COMMIT" "$(date +%s)" >"$temporary"
    chmod 0640 "$temporary"
    mv -f -- "$temporary" "$REQUEST_FILE"
    json_status "requested" "deployment request queued"
}

request_release() {
    if [[ "$DRY_RUN" == "1" ]]; then
        json_status "request" "dry-run deployment request accepted"
        return
    fi
    [[ "$(id -u)" == "0" ]] || {
        echo "Deployment requests require the allowlisted root helper." >&2
        return 1
    }
    acquire_transition_lock
    load_release_config
    queue_release_request
}

prune_releases() {
    mapfile -t releases < <(
        find "$RELEASE_ROOT" -mindepth 1 -maxdepth 1 -type d \
            ! -name '.stage-*' ! -name '.quarantine-*' -printf '%T@ %p\n' |
            sort -rn | awk '{print $2}'
    )
    local current previous index
    current="$(readlink -f "$RUNTIME_LINK/source" 2>/dev/null || true)"
    previous="$(sed -n '1p' "$PREVIOUS_FILE" 2>/dev/null || true)"
    for ((index=KEEP_RELEASES; index<${#releases[@]}; index++)); do
        [[ "${releases[$index]}" == "$current" || "${releases[$index]}" == "$previous" ]] && continue
        rm -rf --one-file-system -- "${releases[$index]}"
    done
}

promote_staged_release() {
    local staged_source="$1" staged_runtime="$2" final="$3" runtime_final="$4"
    local quarantine
    if [[ -e "$final" ]]; then
        quarantine="$RELEASE_ROOT/.quarantine-${RELEASE_COMMIT}-$(date +%s)-$$"
        mv -- "$final" "$quarantine"
    fi
    if [[ -e "$runtime_final" ]]; then
        quarantine="$RUNTIME_ROOT/.quarantine-${RELEASE_COMMIT}-$(date +%s)-$$"
        mv -- "$runtime_final" "$quarantine"
    fi
    mv -- "$staged_source" "$final"
    mv -- "$staged_runtime" "$runtime_final"
}

deploy_release() {
    local deployment_mode="${1:-activate}"
    if [[ "$DRY_RUN" == "1" ]]; then
        json_status "deploy" "dry-run deploy policy passed"
        return
    fi
    [[ "$(id -u)" == "0" ]] || {
        echo "Deployment requires root." >&2
        return 1
    }
    load_release_config
    install -d -o root -g "$RUNTIME_GROUP" -m 0750 \
        "$RELEASE_ROOT" "$STATE_ROOT" "$RUNTIME_ROOT"
    acquire_transition_lock
    rm -f -- "$REQUEST_FILE"
    local current stage final runtime_final prior_runtime python_minor
    current="$(active_commit)"
    stage="$(mktemp -d "$RELEASE_ROOT/.stage-${RELEASE_TAG}.XXXXXX")"
    trap 'rm -rf --one-file-system -- "$stage"' EXIT
    install -d -m 0700 "$stage/source"
    fetch_exact_release "$stage/source"
    verify_forward_history "$stage/source" "$current"
    if [[ "$current" == "$RELEASE_COMMIT" ]]; then
        if ! active_release_verified; then
            update_status "blocked"
            json_status "blocked" "active release failed exact source or runtime verification"
            return 1
        fi
        update_status "current"
        json_status "current" "configured release is already active"
        return
    fi
    python3 -m venv "$stage/source/.venv"
    python_minor="$("$stage/source/.venv/bin/python" -c \
        'import sys; print("313" if sys.version_info[:2] >= (3, 13) else "310")')"
    "$stage/source/.venv/bin/python" -m pip install --disable-pip-version-check \
        --requirement "$stage/source/requirements/media.txt" \
        --constraint "$stage/source/constraints/py${python_minor}.txt"
    "$stage/source/.venv/bin/python" -m pip check
    preflight_release "$stage/source"

    prior_runtime="$(readlink -f "$RUNTIME_LINK" 2>/dev/null || true)"
    final="$RELEASE_ROOT/$RELEASE_COMMIT"
    runtime_final="$RUNTIME_ROOT/$RELEASE_COMMIT"
    prepare_runtime "$stage/source" "$stage/runtime" "$prior_runtime" "$final"
    promote_staged_release \
        "$stage/source" "$stage/runtime" "$final" "$runtime_final"
    secure_release "$final"
    trap - EXIT
    rm -rf --one-file-system -- "$stage"
    if [[ "$deployment_mode" == "stage" ]]; then
        write_staged_release_metadata "$final" "$runtime_final"
        json_status "staged" "verified release and writable runtime are staged"
        return
    fi
    activate_release "$final" "$runtime_final"
    update_status "current"
    prune_releases
}

rollback_release_locked() {
    if [[ "$DRY_RUN" == "1" ]]; then
        json_status "rollback" "dry-run rollback policy passed"
        return
    fi
    [[ "$(id -u)" == "0" ]]
    load_release_config
    local target_tag="$RELEASE_TAG" target_commit="$RELEASE_COMMIT"
    local previous_source previous_runtime current_source current_runtime
    local previous_tag previous_commit current_tag="" current_commit=""
    local -a previous_paths=()
    mapfile -t previous_paths < <(read_previous_release)
    [[ "${#previous_paths[@]}" == "2" ]] || {
        echo "Recorded previous release state is missing or unsafe." >&2
        return 1
    }
    previous_source="${previous_paths[0]}"
    previous_runtime="${previous_paths[1]}"
    local -a previous_identity=()
    mapfile -t previous_identity < <(
        validated_managed_release_identity "$previous_source"
    ) || {
        echo "Recorded previous release metadata could not be validated." >&2
        return 1
    }
    [[ "${#previous_identity[@]}" == "2" ]] || {
        echo "Recorded previous release metadata is incomplete." >&2
        return 1
    }
    previous_tag="${previous_identity[0]}"
    previous_commit="${previous_identity[1]}"
    validated_managed_runtime "$previous_runtime" "$previous_commit" || {
        echo "Recorded previous runtime does not match its immutable release." >&2
        return 1
    }
    current_runtime="$(readlink -f "$RUNTIME_LINK" 2>/dev/null || true)"
    current_source="$(readlink -f "$current_runtime/source" 2>/dev/null || true)"
    local -a current_identity=()
    mapfile -t current_identity < <(
        validated_managed_release_identity "$current_source"
    ) || current_identity=()
    if [[ "${#current_identity[@]}" == "2" ]] \
        && validated_managed_runtime \
            "$current_runtime" "${current_identity[1]}"; then
        current_tag="${current_identity[0]}"
        current_commit="${current_identity[1]}"
    fi
    local old_pid
    old_pid="$(service_main_pid 2>/dev/null || printf '0')"
    if ! stop_service_verified; then
        json_status "rollback_failed" \
            "manual rollback stop failed or inactive state was not confirmed"
        echo "Service stop was not verified; rollback selector was not changed." >&2
        return 1
    fi
    set_active_workspace "$previous_runtime"
    rm -f -- "$READY_FILE"
    if ! validated_activation_pair "$previous_source" "$previous_runtime" \
        "$previous_tag" "$previous_commit"; then
        echo "Recorded previous runtime changed before service start." >&2
        rollback_activation "$current_source" "$current_runtime" \
            "manual rollback target failed second validation" \
            "$current_tag" "$current_commit"
        return 1
    fi
    local started
    started="$(date +%s)"
    if ! systemctl start "$SERVICE" || ! wait_ready "$started" "$old_pid"; then
        rollback_activation "$current_source" "$current_runtime" \
            "manual rollback failed" "$current_tag" "$current_commit"
        return 1
    fi
    RELEASE_TAG="$target_tag"
    RELEASE_COMMIT="$target_commit"
    publish_rollback_metadata "$previous_tag" "$previous_commit" \
        "recorded previous release is active and fresh-ready"
}

rollback_release() {
    if [[ "$DRY_RUN" == "1" ]]; then
        json_status "rollback" "dry-run rollback policy passed"
        return
    fi
    [[ "$(id -u)" == "0" ]]
    acquire_transition_lock
    rollback_release_locked
}

if [[ "${BOUDYOS_DEPLOY_LIB:-0}" != "1" ]]; then
case "${1:-}" in
    check) check_release ;;
    request) request_release ;;
    preflight)
        if [[ "$DRY_RUN" == "1" ]]; then
            preflight_release "."
        else
            preflight_release "${2:?source required}"
        fi
        ;;
    stage) deploy_release stage ;;
    deploy) deploy_release activate ;;
    status)
        if [[ "$DRY_RUN" == "1" ]]; then
            json_status "status" "dry-run status available"
        elif [[ -r "$STATUS_FILE" ]]; then
            cat "$STATUS_FILE"
        else
            load_release_config
            json_status "unknown" "no deployment status is available"
        fi
        ;;
    rollback) rollback_release ;;
    *)
        echo "Usage: $0 {check|request|preflight <source>|stage|deploy|status|rollback}" >&2
        exit 2
        ;;
esac
fi
